# =============================================================================
# journey-core — variáveis de ambiente
# Copie para .env (ou rode `make setup`, que gera o salt automaticamente).
# =============================================================================

# Ambiente: development | testing | production
APP_ENV=development

# Salt do hash de telefone (HMAC-SHA256). Obrigatório, mínimo 16 caracteres.
# Gere com: openssl rand -hex 32
# Trocar o salt invalida a correlação entre cadastro e trilha de eventos.
PHONE_HASH_SALT=

# Logs: DEBUG | INFO | WARNING | ERROR — formato console | json
LOG_LEVEL=INFO
LOG_FORMAT=console

# Documentação interativa (Swagger em /docs)
DOCS_ENABLED=true

# Caminhos dos artefatos declarativos (defaults apontam para dentro de app/)
# PROTOCOL_TEMPLATES_DIR=app/features/protocols/templates
# JOURNEY_PLANS_DIR=app/features/journeys/plans
# FOLLOWUP_RULES_PATH=app/features/followups/rules/default.yaml
